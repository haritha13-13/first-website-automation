# Copy this file to .env and fill in values.
# Used for logging into Behance (or other protected sites) during workflows.

BEHANCE_EMAIL=
BEHANCE_PASSWORD=

# Optional: disable headless browsing (for debugging) / slow down actions
# AUTOMATOR_HEADLESS=0
# AUTOMATOR_SLOWMO=150

# Optional LLM backend for smarter workflow discovery
# LLM_PROVIDER=openai|anthropic
# LLM_API_KEY=...
# LLM_MODEL=...